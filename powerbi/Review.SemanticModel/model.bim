{
  "name": "Review",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Cohorts",
        "columns": [
          {
            "name": "month",
            "sourceColumn": "month",
            "dataType": "string"
          },
          {
            "name": "category",
            "sourceColumn": "category",
            "dataType": "string"
          },
          {
            "name": "product",
            "sourceColumn": "product",
            "dataType": "string"
          },
          {
            "name": "channel",
            "sourceColumn": "channel",
            "dataType": "string"
          },
          {
            "name": "shipped_units",
            "sourceColumn": "shipped_units",
            "dataType": "int64"
          },
          {
            "name": "returned_units",
            "sourceColumn": "returned_units",
            "dataType": "int64"
          },
          {
            "name": "refund_c",
            "sourceColumn": "refund_c",
            "dataType": "int64"
          },
          {
            "name": "initial_margin_c",
            "sourceColumn": "initial_margin_c",
            "dataType": "int64"
          },
          {
            "name": "erosion_c",
            "sourceColumn": "erosion_c",
            "dataType": "int64"
          }
        ],
        "partitions": [
          {
            "name": "Cohorts",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"shipped_units\", Int64.Type}, {\"returned_units\", Int64.Type}, {\"refund_c\", Int64.Type}, {\"initial_margin_c\", Int64.Type}, {\"erosion_c\", Int64.Type}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Units shipped",
            "expression": "SUM(Cohorts[shipped_units])",
            "formatString": "#,0"
          },
          {
            "name": "Units returned",
            "expression": "SUM(Cohorts[returned_units])",
            "formatString": "#,0"
          },
          {
            "name": "Return rate",
            "expression": "DIVIDE([Units returned], [Units shipped])",
            "formatString": "0.00%"
          },
          {
            "name": "Margin erosion",
            "expression": "SUM(Cohorts[erosion_c]) / 100",
            "formatString": "\u20ac#,0.00"
          },
          {
            "name": "Refunds",
            "expression": "SUM(Cohorts[refund_c]) / 100",
            "formatString": "\u20ac#,0.00"
          }
        ]
      },
      {
        "name": "Drivers",
        "columns": [
          {
            "name": "priority",
            "sourceColumn": "priority",
            "dataType": "int64"
          },
          {
            "name": "product",
            "sourceColumn": "product",
            "dataType": "string"
          },
          {
            "name": "channel",
            "sourceColumn": "channel",
            "dataType": "string"
          },
          {
            "name": "reason",
            "sourceColumn": "reason",
            "dataType": "string"
          },
          {
            "name": "events",
            "sourceColumn": "events",
            "dataType": "int64"
          },
          {
            "name": "erosion_c",
            "sourceColumn": "erosion_c",
            "dataType": "int64"
          },
          {
            "name": "share_pct",
            "sourceColumn": "share_pct",
            "dataType": "double"
          }
        ],
        "partitions": [
          {
            "name": "Drivers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"priority\", Int64.Type}, {\"events\", Int64.Type}, {\"erosion_c\", Int64.Type}, {\"share_pct\", type number}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Return events",
            "expression": "SUM(Drivers[events])",
            "formatString": "#,0"
          },
          {
            "name": "Cost exposure",
            "expression": "SUM(Drivers[erosion_c]) / 100",
            "formatString": "\u20ac#,0.00"
          }
        ]
      }
    ]
  }
}
